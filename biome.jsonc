{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/jest"],
  "linter": {
    "rules": {
      "style": {
        "noMagicNumbers": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        // External API responses don't always match their declared types,
        // so optional chaining on them is a runtime guard, not dead code.
        "noUnnecessaryConditions": "off",
        // Flags function parameters sharing a name with interface properties.
        "noShadow": "off",
        // Flags expect() in test helpers, even when only called inside it().
        "noMisplacedAssertion": "off"
      }
    }
  }
}
